#include <stdio.h>
int main() {
  FILE *pipe;
  char ch;
  char buffer[50];
  char *buff_ret; // buffer error
  pipe = popen("ls", "r");
  if( pipe == NULL)
    {
        puts("Unable to open process");
        return(1);
    }
  char reading = 1; // flag 
  while (reading) {
    buff_ret = fgets(buffer, sizeof(buffer), pipe);
    if (buff_ret == NULL){
      reading = 0;
    }else{
    printf("%s", buffer);
    }
  }
  pclose(pipe);
  return 0;
}
